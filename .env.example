# Campaign Logger — live-test config TEMPLATE (issue #62)
# ========================================================
# Copy this to a gitignored env file and fill in the blanks:
#
#   cp .env.example .env.sandbox
#   # edit .env.sandbox, then:
#   set -a; source .env.sandbox; set +a
#   pytest --run-live-read
#
# Keep each environment in its own file (.env.sandbox for staging,
# .env.prod for production if ever needed) so they can never be sourced
# together. This template holds no secrets and is the only .env* that is
# tracked in git.
#
# Mint keys in the target environment's UI, e.g. staging:
#   https://app.preview.campaign-logger.com/tokens

# --- Logger API --------------------------------------------------------------
CL_LOGGER_URL=https://logger-staging.campaign-logger.com
CL_LOGGER_CLIENT_ID=
CL_LOGGER_CLIENT_SECRET=

# --- Sacrificial campaign (G3) ----------------------------------------------
# A campaign whose title starts with the object prefix below. The write
# preflight refuses unless the id resolves to a campaign with this exact title.
CL_LIVE_SACRIFICIAL_CAMPAIGN_ID=
CL_LIVE_SACRIFICIAL_CAMPAIGN_TITLE=PYTEST-LIVE-sandbox
# CL_LIVE_OBJECT_PREFIX=PYTEST-LIVE-

# --- Generator API (optional; needs --run-live-generators) -------------------
# CL_GENERATOR_URL=https://generator.campaign-logger.com
# CL_GENERATOR_TOKEN=
